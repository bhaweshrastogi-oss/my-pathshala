# PhonePe (server)
PHONEPE_ENV=production
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=
CORS_ORIGINS=https://pmpathshala.com,https://www.pmpathshala.com

# Student confirmation email (Resend — https://resend.com)
# Without RESEND_API_KEY, /api/send-confirmation skips sending (site still works).
RESEND_API_KEY=
# Testing: use Resend's onboarding sender after you sign up:
# RESEND_FROM=PMpathshala <onboarding@resend.dev>
# Production: verify pmpathshala.com in Resend, then e.g.:
# RESEND_FROM=PMpathshala <support@pmpathshala.com>
# (If RESEND_FROM is unset, the code defaults to PMpathshala <support@pmpathshala.com>,
#  which only works once pmpathshala.com is verified in Resend.)

# Waitlist offer (₹30,000 personal links). Any long random string, e.g. run:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# MUST be identical here (Vercel) and when you run tools/waitlist-announcement.js.
# If unset, waitlist links are rejected and everyone pays the public price.
WAITLIST_SECRET=
